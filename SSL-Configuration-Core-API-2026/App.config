<?xml version="1.0" encoding="utf-8" ?>
<!--
  VerisignGateway reads Comodo URLs via System.Configuration.ConfigurationManager.AppSettings.
  This App.config is copied to SSL-Configuration-Core-API-2026.dll.config on build.
  Program.cs also syncs AppSettings from appsettings*.json into ConfigurationManager at startup.
-->
<configuration>
  <appSettings>
    <add key="DefaultComodoCredential" value="FTI_Comodo" />
    <add key="Comodo_ParseCSR" value="https://secure.sectigo.com/products/!DecodeCSR" />
    <add key="Comodo_ApproverEmail" value="https://secure.trust-provider.com/products/!GetDCVEmailAddressList" />
    <add key="Comodo_TestMode" value="N" />
    <add key="Comodo_PlaceOrder" value="https://secure.trust-provider.com/products/!AutoApplySSL" />
    <add key="Comodo_ResenedApproverEmail" value="https://secure.trust-provider.com/products/!ResendDCVEmail" />
    <add key="Comodo_Authrize_URL" value="https://secure.trust-provider.com/products/!AutoAuthorize" />
    <add key="Comodo_ChangeDVCMethod_URL" value="https://secure.trust-provider.com/products/!AutoUpdateDCV" />
    <add key="Comodo_OrderStatusURL" value="https://secure.trust-provider.com/products/download/CollectSSL" />
    <add key="Comodo_ReIssue_URL" value="https://secure.trust-provider.com/products/!AutoReplaceSSL" />
    <add key="Comodo_ChangeApprovalEmail" value="https://secure.trust-provider.com/products/!AutoUpdateDCV" />
    <add key="Comodo_GetSANList_URL" value="https://secure.trust-provider.com/products/!GetMDCDomainDetails" />
    <add key="Comodo_ProvideEVDetailURL" value="https://secure.trust-provider.com/products/!ProvideEVDetails" />
    <add key="Comodo_GetDetailedOrderStatus_URL" value="https://secure.comodo.net/products/!GetDetailedOrderStatus" />
    <add key="ComodoCancelOrder_URL" value="https://secure.comodo.net/products/!AutoReject" />
    <add key="ComodoRevokeCertificate_URL" value="https://secure.trust-provider.com/products/!AutoRevokeSSL" />
    <add key="Change_EV_Agreement_Email" value="https://secure.trust-provider.com/products/!UpdateUserEvClickThrough" />
    <add key="Comodo_RetryCAACheck_URL" value="https://secure.trust-provider.com/products/!RetryCAACheck" />
    <add key="Comodo_AutoRemoveMDCDomain_URL" value="https://secure.trust-provider.com/products/!AutoRemoveMDCDomain" />
    <add key="Comodo_CodesignOrder_URL" value="https://secure.trust-provider.com/products/!AutoApplyOrder" />
    <add key="Comodo_CodeSignOrderStatusURL" value="https://secure.trust-provider.com/products/download/CollectCCC" />
    <add key="Comodo_CodeSign_RevokeCertificateURL" value="https://secure.trust-provider.com/products/!autoRevokeCS" />
    <add key="Comodo_CodeSign_ReIssue_URL" value="https://secure.trust-provider.com/products/!AutoReplaceCS" />
    <add key="ComodoPAC_Order" value="https://secure.trust-provider.com/products/!AutoApplyOrder" />
    <add key="Comodo_PACOrderStatusURL" value="https://secure.trust-provider.com/products/download/CollectPAC" />
    <add key="Comodo_PAC_RevokeURL" value="https://secure.trust-provider.com/products/!AutoRevokePAC" />
    <add key="Comodo_PAC_ReIssue_URL" value="https://secure.trust-provider.com/products/!AutoReplaceSMIME" />
    <add key="Comodo_PAC_SMIME_VerificationEmail_URL" value="https://secure.trust-provider.com/products/!ResendVerificationEmailSMIME" />
    <add key="Comodo_PAC_SMIME_InvitationEmail_URL" value="https://secure.trust-provider.com/products/!ResendInvitationEmailSMIME" />
    <add key="Comodo_PAC_SMIME_CollectionEmail_URL" value="https://secure.trust-provider.com/products/!ResendCollectionEmailSMIME" />
    <add key="Comodo_PAC_SMIME_Certificate_URL" value="https://secure.trust-provider.com/products/download/CollectSMIME" />
    <add key="Comodo_PAC_SMIME_RevokeCertificate_URL" value="https://secure.trust-provider.com/products/!autoRevokeCertificate" />
    <add key="ComodoBulkOrderStatusReq_URL" value="https://secure.trust-provider.com/products/!WebHostReport" />
    <add key="ComodoAutoRefund_URL" value="https://secure.trust-provider.com/products/!AutoRefund" />
    <add key="SectigoPostPaymentStatusURL" value="https://secure.trust-provider.com/products/!getPostPaymentStatus" />
    <add key="DONOTAuthorizedCodeSign" value="363cc761-0bea-4814-8f5b-5b89c768ddc5" />
	<add key="AdminUserName" value="admin@aspen-it.com"/>
	<add key="AdminPassword" value="1"/>
  </appSettings>
</configuration>
